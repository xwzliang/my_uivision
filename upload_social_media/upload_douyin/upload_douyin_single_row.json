{
  "Name": "DouyinUploadVideoSingleRow",
  "CreationDate": "2026-07-12",
  "Commands": [
    { "Command": "store", "Target": "false", "Value": "!errorignore", "Description": "Fail on unexpected UI changes." },
    { "Command": "store", "Target": "120", "Value": "!TIMEOUT_PAGELOAD", "Description": "" },
    { "Command": "store", "Target": "600", "Value": "!TIMEOUT_WAIT", "Description": "Default upload wait: 10 minutes." },
    { "Command": "store", "Target": "1", "Value": "!csvReadLineNumber", "Description": "The runner writes exactly one data row." },
    { "Command": "csvRead", "Target": "/Users/broliang/uivision/datasources/douyin_upload_current.csv", "Value": "", "Description": "COL1=video, COL2=title, COL3=caption, COL4=publish time, COL5=cover, COL6=publish mode." },
    { "Command": "store", "Target": "${!COL1}", "Value": "VIDEO_PATH", "Description": "" },
    { "Command": "store", "Target": "${!COL2}", "Value": "VIDEO_TITLE", "Description": "" },
    { "Command": "store", "Target": "${!COL3}", "Value": "VIDEO_CAPTION", "Description": "Description followed by #topics." },
    { "Command": "store", "Target": "${!COL4}", "Value": "PUBLISH_AT", "Description": "Empty means immediate; otherwise YYYY-MM-DD HH:MM." },
    { "Command": "store", "Target": "${!COL5}", "Value": "COVER_PATH", "Description": "Optional custom cover image." },
    { "Command": "store", "Target": "${!COL6}", "Value": "PUBLISH_MODE", "Description": "Explicit scheduled/immediate flag generated by the runner." },
    { "Command": "echo", "Target": "DOUYIN_UPLOAD_STARTED file=${VIDEO_PATH}", "Value": "blue", "Description": "" },
    { "Command": "echo", "Target": "DOUYIN_PUBLISH_MODE=${PUBLISH_MODE} publish_at=${PUBLISH_AT}", "Value": "blue", "Description": "" },
    { "Command": "store", "Target": "30", "Value": "!TIMEOUT_PAGELOAD", "Description": "Do not wait two minutes for Douyin's long-lived page requests." },
    { "Command": "store", "Target": "true", "Value": "!errorignore", "Description": "The upload UI can be usable even when open reports a page-load timeout." },
    { "Command": "open", "Target": "https://creator.douyin.com/creator-micro/content/upload", "Value": "", "Description": "The Chrome profile must already be logged in." },
    { "Command": "store", "Target": "false", "Value": "!errorignore", "Description": "Resume strict error handling after navigation." },
    { "Command": "store", "Target": "120", "Value": "!TIMEOUT_PAGELOAD", "Description": "Restore the normal page-load timeout." },
    { "Command": "waitForElementPresent", "Target": "css=div[class^='container'] input[type='file']", "Value": "", "Description": "Use the real upload control—not the browser load event—as the readiness signal." },
    { "Command": "type", "Target": "css=div[class^='container'] input[type='file']", "Value": "${VIDEO_PATH}", "Description": "Equivalent to Playwright set_input_files." },
    { "Command": "waitForElementVisible", "Target": "xpath=//input[contains(@placeholder,'填写作品标题')]", "Value": "", "Description": "The current Douyin post/video form can take about 40 seconds to appear." },
    { "Command": "bringBrowserToForeground", "Target": "", "Value": "", "Description": "XType below needs the browser focused." },
    { "Command": "type", "Target": "css=input[placeholder*='填写作品标题']", "Value": "${VIDEO_TITLE}", "Description": "The runner truncates this to Douyin's 30-character limit." },
    { "Command": "click", "Target": "css=div.zone-container[contenteditable='true']", "Value": "", "Description": "" },
    { "Command": "XType", "Target": "${KEY_CMD+KEY_A}${KEY_BACKSPACE}", "Value": "", "Description": "Clear the rich-text caption editor on macOS." },
    { "Command": "XType", "Target": "${VIDEO_CAPTION}${KEY_ESC}", "Value": "", "Description": "Escape closes the topic suggestion overlay." },
    { "Command": "store", "Target": "900", "Value": "!TIMEOUT_WAIT", "Description": "Allow up to 15 minutes for video transfer." },
    { "Command": "waitForElementVisible", "Target": "xpath=//*[normalize-space()='重新上传']", "Value": "", "Description": "Upstream treats the Re-upload control as the completion signal." },
    { "Command": "store", "Target": "600", "Value": "!TIMEOUT_WAIT", "Description": "Restore the normal 10-minute wait timeout." },
    { "Command": "if_v2", "Target": "'${COVER_PATH}' != ''", "Value": "", "Description": "Upload a custom cover when column 6 is provided." },
    { "Command": "click", "Target": "xpath=(//div[contains(@class,'coverControl-')][.//*[contains(@class,'cover-tip') and contains(normalize-space(),'竖封面3:4')]]//*[normalize-space()='选择封面' or normalize-space()='编辑封面'])[1]", "Value": "", "Description": "Open only the 3:4 vertical cover editor for the custom image." },
    { "Command": "waitForElementVisible", "Target": "css=div.dy-creator-content-modal", "Value": "", "Description": "Wait for the cover modal." },
    { "Command": "click", "Target": "xpath=(//*[contains(@class,'upload-tips')][.//*[normalize-space()='上传封面']] | //*[normalize-space()='上传封面'])[1]", "Value": "", "Description": "Select the Upload cover area supplied by the current Douyin UI." },
    { "Command": "type", "Target": "xpath=(//div[contains(@class,'dy-creator-content-modal')]//div[contains(@class,'container-') and contains(@class,'upload-')]//input[contains(concat(' ',normalize-space(@class),' '),' semi-upload-hidden-input ')])[1]", "Value": "${COVER_PATH}", "Description": "Use the hidden image file input, matching the ChatGPT image macro's upload method." },
    { "Command": "pause", "Target": "3000", "Value": "", "Description": "Wait for the uploaded cover preview." },
    { "Command": "times", "Target": "10", "Value": "", "Description": "Hard limit: try at most ten zoom-out clicks." },
    { "Command": "storeXpathCount", "Target": "xpath=//*[local-name()='svg' and @width='18' and @height='18' and contains(translate(@style,' ',''),'cursor:pointer') and ./*[local-name()='circle' and @cx='8.5' and @cy='8.5'] and ./*[local-name()='path' and contains(translate(@d,' ',''),'M6.58.5H10.5')]]", "Value": "ENABLED_ZOOM_OUT_COUNT", "Description": "Namespace-safe, non-blocking match for the enabled minus magnifier." },
    { "Command": "if_v2", "Target": "${ENABLED_ZOOM_OUT_COUNT} > 0", "Value": "", "Description": "Skip clicking after the control changes to cursor: no-drop." },
    { "Command": "click", "Target": "xpath=(//*[local-name()='svg' and @width='18' and @height='18' and contains(translate(@style,' ',''),'cursor:pointer') and ./*[local-name()='circle' and @cx='8.5' and @cy='8.5'] and ./*[local-name()='path' and contains(translate(@d,' ',''),'M6.58.5H10.5')]])[1]", "Value": "", "Description": "Zoom out one step." },
    { "Command": "pause", "Target": "300", "Value": "", "Description": "Allow the crop control state to update." },
    { "Command": "end", "Target": "", "Value": "", "Description": "End enabled-control condition." },
    { "Command": "end", "Target": "", "Value": "", "Description": "End ten-iteration zoom limit." },
    { "Command": "click", "Target": "xpath=(//div[contains(@class,'dy-creator-content-modal')]//button[normalize-space()='完成'])[1]", "Value": "", "Description": "Apply the custom cover." },
    { "Command": "waitForElementNotPresent", "Target": "css=div.dy-creator-content-modal", "Value": "", "Description": "Wait for the cover editor to close." },
    { "Command": "click", "Target": "xpath=(//div[contains(@class,'coverControl-')][.//*[contains(@class,'cover-tip') and contains(normalize-space(),'横封面4:3')]]//*[normalize-space()='选择封面' or normalize-space()='编辑封面'])[1]", "Value": "", "Description": "Open only the 4:3 horizontal cover editor for the recommended image." },
    { "Command": "waitForElementVisible", "Target": "css=div.dy-creator-content-modal", "Value": "", "Description": "Wait for the recommended-cover editor." },
    { "Command": "waitForElementVisible", "Target": "xpath=(//div[contains(@class,'aiGenCoverList-')]//div[contains(@class,'aiGenCoverListInnerList-')]/div[contains(@class,'container-')][.//div[contains(@class,'aiCover-')]])[1]", "Value": "", "Description": "Wait for the asynchronously rendered first AI cover." },
    { "Command": "click", "Target": "xpath=(//div[contains(@class,'aiGenCoverList-')]//div[contains(@class,'aiGenCoverListInnerList-')]/div[contains(@class,'container-')][.//div[contains(@class,'aiCover-')]])[1]", "Value": "", "Description": "Select the first AI/recommended cover in the list." },
    { "Command": "pause", "Target": "1000", "Value": "", "Description": "Allow the recommended cover preview to update." },
    { "Command": "click", "Target": "xpath=(//div[contains(@class,'dy-creator-content-modal')]//button[normalize-space()='完成'])[1]", "Value": "", "Description": "Apply the recommended 4:3 cover." },
    { "Command": "waitForElementNotPresent", "Target": "css=div.dy-creator-content-modal", "Value": "", "Description": "Wait for the second cover editor to close." },
    { "Command": "end", "Target": "", "Value": "", "Description": "" },
    { "Command": "if_v2", "Target": "'${PUBLISH_MODE}' == 'scheduled'", "Value": "", "Description": "Do not rely on UI.Vision's handling of empty CSV cells." },
    { "Command": "click", "Target": "xpath=//*[contains(@class,'radio')][contains(.,'定时发布')]", "Value": "", "Description": "" },
    { "Command": "pause", "Target": "1000", "Value": "", "Description": "" },
    { "Command": "type", "Target": "css=input.semi-input[placeholder='日期和时间']", "Value": "${PUBLISH_AT}${KEY_ENTER}", "Description": "" },
    { "Command": "else", "Target": "", "Value": "", "Description": "No scheduled time was provided." },
    { "Command": "click", "Target": "xpath=(//label[contains(@class,'radio-')][.//span[normalize-space()='立即发布']] | //label[.//input[@value='0'] and .//span[normalize-space()='立即发布']])[1]", "Value": "", "Description": "Explicitly select immediate publishing mode." },
    { "Command": "end", "Target": "", "Value": "", "Description": "" },
    { "Command": "storeXpathCount", "Target": "xpath=//*[normalize-space()='请选择自主声明']", "Value": "DECLARATION_COUNT", "Description": "Newer publish pages require this choice." },
    { "Command": "if_v2", "Target": "${DECLARATION_COUNT} > 0", "Value": "", "Description": "" },
    { "Command": "click", "Target": "xpath=(//*[normalize-space()='请选择自主声明'])[1]", "Value": "", "Description": "" },
    { "Command": "pause", "Target": "1000", "Value": "", "Description": "" },
    { "Command": "click", "Target": "xpath=(//*[contains(@class,'semi-modal-content')]//label[contains(@class,'semi-radio')][.//*[contains(@class,'semi-radio-addon') and normalize-space()='内容由AI生成']])[1]", "Value": "", "Description": "Select the AI-generated content declaration." },
    { "Command": "click", "Target": "xpath=(//*[contains(@class,'semi-modal-content')]//button[normalize-space()='确定'])[1]", "Value": "", "Description": "" },
    { "Command": "end", "Target": "", "Value": "", "Description": "" },
    { "Command": "storeXpathCount", "Target": "xpath=//*[contains(normalize-space(),'请设置封面后再发布')]", "Value": "COVER_REQUIRED", "Description": "" },
    { "Command": "if_v2", "Target": "${COVER_REQUIRED} > 0", "Value": "", "Description": "" },
    { "Command": "click", "Target": "xpath=(//*[contains(@class,'recommendCover-')])[1]", "Value": "", "Description": "Apply the first Douyin-recommended cover, matching upstream fallback behavior." },
    { "Command": "pause", "Target": "1000", "Value": "", "Description": "" },
    { "Command": "storeXpathCount", "Target": "xpath=//*[contains(normalize-space(),'是否确认应用此封面')]", "Value": "COVER_CONFIRM", "Description": "" },
    { "Command": "if_v2", "Target": "${COVER_CONFIRM} > 0", "Value": "", "Description": "" },
    { "Command": "click", "Target": "xpath=(//button[normalize-space()='确定'])[last()]", "Value": "", "Description": "" },
    { "Command": "end", "Target": "", "Value": "", "Description": "" },
    { "Command": "end", "Target": "", "Value": "", "Description": "" },
    { "Command": "pause", "Target": "1000", "Value": "", "Description": "" },
    { "Command": "comment", "Target": "click | xpath=(//button[normalize-space()='发布'])[1]", "Value": "", "Description": "DRY RUN: actual publishing is intentionally disabled for workflow testing." },
    { "Command": "echo", "Target": "DOUYIN_UPLOAD_DRY_RUN_COMPLETED file=${VIDEO_PATH} publish_click=skipped", "Value": "green", "Description": "Video is uploaded and the form is prepared, but it has not been published." },
    { "Command": "label", "Target": "MACRO_END", "Value": "", "Description": "" }
  ]
}
