{
  "Name": "KuaishouUploadVideoSingleRow",
  "CreationDate": "2026-07-13",
  "Commands": [
    {
      "Command": "store",
      "Target": "false",
      "Value": "!errorignore",
      "Description": ""
    },
    {
      "Command": "store",
      "Target": "600",
      "Value": "!TIMEOUT_WAIT",
      "Description": "Default upload wait: 10 minutes."
    },
    {
      "Command": "store",
      "Target": "1",
      "Value": "!csvReadLineNumber",
      "Description": ""
    },
    {
      "Command": "csvRead",
      "Target": "/Users/broliang/uivision/datasources/kuaishou_upload_current.csv",
      "Value": "",
      "Description": "video,title,caption,publish_at,category,cover,publish_mode"
    },
    {
      "Command": "store",
      "Target": "${!COL6}",
      "Value": "COVER_PATH",
      "Description": "Optional 3:4 custom cover image."
    },
    {
      "Command": "store",
      "Target": "${!COL3}",
      "Value": "VIDEO_DESCRIPTION",
      "Description": "Title, original description, and hashtags generated by the runner."
    },
    {
      "Command": "store",
      "Target": "${!COL4}",
      "Value": "PUBLISH_AT",
      "Description": "Scheduled timestamp, empty for immediate publishing."
    },
    {
      "Command": "store",
      "Target": "${!COL7}",
      "Value": "PUBLISH_MODE",
      "Description": "Explicit scheduled/immediate flag generated by the runner."
    },
    {
      "Command": "echo",
      "Target": "KUAISHOU_PUBLISH_MODE=${PUBLISH_MODE} publish_at=${PUBLISH_AT}",
      "Value": "blue",
      "Description": ""
    },
    {
      "Command": "open",
      "Target": "https://cp.kuaishou.com/article/publish/video",
      "Value": "",
      "Description": ""
    },
    {
      "Command": "waitForPageToLoad",
      "Target": "",
      "Value": "",
      "Description": ""
    },
    {
      "Command": "pause",
      "Target": "3000",
      "Value": "",
      "Description": "Allow the upload widget to mount."
    },
    {
      "Command": "type",
      "Target": "css=input[type='file'][accept*='video']",
      "Value": "${!COL1}",
      "Description": "Hidden input behind the upstream _upload-btn file chooser."
    },
    {
      "Command": "waitForElementVisible",
      "Target": "xpath=(//div[normalize-space()='重新上传']/ancestor::div[contains(@class,'button')][1])[1]",
      "Value": "",
      "Description": "Wait up to 600 seconds for Kuaishou's completed-upload control; the phone preview may continue showing 上传中."
    },
    {
      "Command": "store",
      "Target": "${VIDEO_DESCRIPTION}",
      "Value": "!clipboard",
      "Description": "Copy the merged Unicode description to the system clipboard for reliable pasting."
    },
    {
      "Command": "bringBrowserToForeground",
      "Target": "",
      "Value": "",
      "Description": "Native XClick requires the Kuaishou tab to be foregrounded."
    },
    {
      "Command": "XClick",
      "Target": "css=#work-description-edit[contenteditable='true']",
      "Value": "",
      "Description": "Native-click Kuaishou's current description editor."
    },
    {
      "Command": "XType",
      "Target": "${KEY_CMD+KEY_A}${KEY_BACKSPACE}",
      "Value": "",
      "Description": "Clear the description editor in a separate native action."
    },
    {
      "Command": "pause",
      "Target": "300",
      "Value": "",
      "Description": "Keep focus in the contenteditable editor."
    },
    {
      "Command": "XType",
      "Target": "${KEY_CMD+KEY_V}",
      "Value": "",
      "Description": "Paste the merged description; manual paste is accepted by Kuaishou's editor."
    },
    {
      "Command": "pause",
      "Target": "500",
      "Value": "",
      "Description": "Allow the contenteditable input event to finish."
    },
    {
      "Command": "XType",
      "Target": "${KEY_ESC}",
      "Value": "",
      "Description": "Dismiss any hashtag suggestions after pasting."
    },
    {
      "Command": "echo",
      "Target": "KUAISHOU_DESCRIPTION_TYPED=${VIDEO_DESCRIPTION}",
      "Value": "blue",
      "Description": ""
    },
    {
      "Command": "bringBrowserToForeground",
      "Target": "",
      "Value": "",
      "Description": "Ensure the native 作者声明 click reaches Kuaishou."
    },
    {
      "Command": "XClick",
      "Target": "xpath=(//div[contains(@class,'ant-select-selector')][.//span[contains(@class,'ant-select-selection-placeholder') and normalize-space()='为作品添加补充说明']]//input[@role='combobox' and @readonly and not(@disabled)])[1]",
      "Value": "",
      "Description": "Native-click 作者声明 by its 为作品添加补充说明 placeholder instead of relying on dynamic rc_select IDs."
    },
    {
      "Command": "waitForElementVisible",
      "Target": "xpath=(//div[contains(concat(' ',normalize-space(@class),' '),' ant-select-item-option ') and @title='内容为AI生成'])[1]",
      "Value": "",
      "Description": "Wait for the visible Ant Design virtual-list option, not its hidden role=option accessibility node."
    },
    {
      "Command": "click",
      "Target": "xpath=(//div[contains(concat(' ',normalize-space(@class),' '),' ant-select-item-option ') and @title='内容为AI生成'])[1]",
      "Value": "",
      "Description": "Set 作者声明 to AI-generated content."
    },
    {
      "Command": "if_v2",
      "Target": "'${COVER_PATH}' != ''",
      "Value": "",
      "Description": "Configure a custom cover when column 7 is provided."
    },
    {
      "Command": "bringBrowserToForeground",
      "Target": "",
      "Value": "",
      "Description": "Ensure the cover control receives the native click."
    },
    {
      "Command": "XClick",
      "Target": "xpath=(//*[contains(@class,'default-cover')][.//*[normalize-space()='封面设置']])[1]",
      "Value": "",
      "Description": "Native-click Kuaishou cover settings."
    },
    {
      "Command": "waitForElementVisible",
      "Target": "xpath=(//*[contains(@class,'header-title-item') and normalize-space()='上传封面'])[1]",
      "Value": "",
      "Description": "Wait for the cover editor."
    },
    {
      "Command": "click",
      "Target": "xpath=(//*[contains(@class,'header-title-item') and normalize-space()='上传封面'])[1]",
      "Value": "",
      "Description": "Switch to custom cover upload."
    },
    {
      "Command": "click",
      "Target": "xpath=(//*[contains(@class,'ratio-item')][.//span[normalize-space()='3:4']])[1]",
      "Value": "",
      "Description": "Choose Kuaishou's recommended 3:4 ratio."
    },
    {
      "Command": "bringBrowserToForeground",
      "Target": "",
      "Value": "",
      "Description": "Native macOS file selection requires browser focus."
    },
    {
      "Command": "click",
      "Target": "xpath=(//button[contains(@class,'upload-btn') and normalize-space()='上传图片'])[1]",
      "Value": "",
      "Description": "Open the macOS image file picker."
    },
    {
      "Command": "pause",
      "Target": "1000",
      "Value": "",
      "Description": "Wait for the file picker."
    },
    {
      "Command": "XType",
      "Target": "${KEY_CMD+KEY_SHIFT+KEY_G}",
      "Value": "",
      "Description": "Open Finder's Go to path field."
    },
    {
      "Command": "pause",
      "Target": "500",
      "Value": "",
      "Description": ""
    },
    {
      "Command": "XType",
      "Target": "${COVER_PATH}${KEY_ENTER}",
      "Value": "",
      "Description": "Enter the absolute cover path."
    },
    {
      "Command": "pause",
      "Target": "1000",
      "Value": "",
      "Description": "Wait for Finder to select the file."
    },
    {
      "Command": "XType",
      "Target": "${KEY_ENTER}",
      "Value": "",
      "Description": "Confirm the selected cover file."
    },
    {
      "Command": "waitForElementVisible",
      "Target": "xpath=(//button[contains(@class,'footer-btn')][.//span[normalize-space()='确认']])[1]",
      "Value": "",
      "Description": "Wait for the uploaded cover preview."
    },
    {
      "Command": "bringBrowserToForeground",
      "Target": "",
      "Value": "",
      "Description": "Ensure the native cover confirmation reaches Kuaishou."
    },
    {
      "Command": "XClick",
      "Target": "xpath=(//button[contains(@class,'footer-btn')][.//span[normalize-space()='确认']])[1]",
      "Value": "",
      "Description": "Native-click to apply the custom cover."
    },
    {
      "Command": "pause",
      "Target": "30000",
      "Value": "",
      "Description": "Wait 30 seconds for Kuaishou to process and apply the custom cover."
    },
    {
      "Command": "end",
      "Target": "",
      "Value": "",
      "Description": ""
    },
    {
      "Command": "if_v2",
      "Target": "'${PUBLISH_MODE}' == 'scheduled'",
      "Value": "",
      "Description": "Do not rely on UI.Vision's handling of empty CSV cells."
    },
    {
      "Command": "click",
      "Target": "xpath=//label[contains(@class,'ant-radio-wrapper')][contains(.,'定时发布')]",
      "Value": "",
      "Description": ""
    },
    {
      "Command": "type",
      "Target": "xpath=(//input[contains(@placeholder,'时间') or contains(@placeholder,'日期')])[1]",
      "Value": "${PUBLISH_AT}${KEY_ENTER}",
      "Description": ""
    },
    {
      "Command": "else",
      "Target": "",
      "Value": "",
      "Description": "No scheduled timestamp was provided."
    },
    {
      "Command": "click",
      "Target": "xpath=(//label[contains(@class,'ant-radio-wrapper')][contains(.,'立即发布')] | //label[.//input[@value='0'] and contains(.,'立即发布')])[1]",
      "Value": "",
      "Description": "Explicitly select immediate publishing mode."
    },
    {
      "Command": "end",
      "Target": "",
      "Value": "",
      "Description": ""
    },
    {
      "Command": "waitForElementNotPresent",
      "Target": "xpath=//span[contains(@class,'_phone-label_') and normalize-space()='上传中']",
      "Value": "",
      "Description": "Final upload barrier: wait up to 600 seconds for the phone-preview uploading label to disappear before publishing."
    },
    {
      "Command": "waitForElementVisible",
      "Target": "xpath=//span[contains(@class,'_tab_') and normalize-space()='预览封面']",
      "Value": "",
      "Description": "Confirm that Kuaishou has switched from uploading to the completed cover-preview state."
    },
    {
      "Command": "pause",
      "Target": "3000",
      "Value": "",
      "Description": ""
    },
    {
      "Command": "comment",
      "Target": "click | xpath=(//*[normalize-space()='发布'])[last()]",
      "Value": "",
      "Description": "DRY RUN: publish and confirmation are disabled."
    },
    {
      "Command": "echo",
      "Target": "KUAISHOU_UPLOAD_DRY_RUN_COMPLETED file=${!COL1}",
      "Value": "green",
      "Description": ""
    }
  ]
}
